# TrusTrove Docker Compose environment variables.
#
# Copy this file to .env.docker and adjust as needed before bringing up the
# local stack with Docker Compose:
#
#   cp .env.docker.example .env.docker
#   docker compose up -d --build
#
# Unlike .env.local (local, host-run development), this file's values reach
# the containerized indexer via the `env_file` block in docker-compose.yml.
# The NEXT_PUBLIC_* variables below are optional: the web image's Dockerfile
# already defaults to the testnet configuration, so most contributors can
# leave them unset and let the build use the baked-in defaults.

# ── Go indexer / backend (plain names) ────────────────────────────────────────
# Pointed at the `db` service on the compose network (hostname `db`), not
# localhost. Maps to the published port 5432 on the host.
DATABASE_URL=postgresql://postgres:postgres@db:5432/trusttrove?sslmode=disable

API_PORT=8080
APP_ENV=development

STELLAR_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

REGISTRY_CONTRACT_ID=CABGWVIZFF62FG67ZGFEP67NEEY4WYTMFURDMFTKKNRDAFPKPOJDTN4C
INVOICE_CONTRACT_ID=CA4O3MR7LWHRSUDBNU6FY6UDFFYBN7TGBZXBDZB4OYYXFYXIFJ6RJF6B
POOL_CONTRACT_ID=CAKEWH7SJCXGV2MH2WZYIX3QDPTSSBQFXYVYBOWAGLNBBZMPLE2US6CS
ESCROW_CONTRACT_ID=CAJWGUKDTTC3SKN4RAAY72J4DVIIYSCFHX6GIMNTT22ABMISJK4GBCEH

USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
USDC_ASSET_CODE=USDC

# Left empty in development: the indexer auto-generates a random keypair at
# startup when APP_ENV != production.
SERVER_SEED=

# JWT_SECRET is a required value; change it before running against anything
# other than a throwaway local database.
JWT_SECRET=local_compose_dev_secret

# The web container is served from the host browser, so the browser always
# calls the API via localhost.
ALLOWED_ORIGINS=http://localhost:3000

# INDEXER_MIGRATIONS_DIR=/app/db/migrations (auto-detected from the working
# directory when unset; set explicitly only if the runtime layout changes).
INDEXER_MIGRATIONS_DIR=/app/db/migrations

# ── Frontend / SDK (optional, baked into the web image at build time) ────────
# The web Dockerfile defaults to these values, so overriding them here
# requires passing the matching --build-arg (or editing docker-compose.yml's
# `build.args` block).
# NEXT_PUBLIC_STELLAR_NETWORK=testnet
# NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
# NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# NEXT_PUBLIC_REGISTRY_CONTRACT_ID=CABGWVIZFF62FG67ZGFEP67NEEY4WYTMFURDMFTKKNRDAFPKPOJDTN4C
# NEXT_PUBLIC_INVOICE_CONTRACT_ID=CA4O3MR7LWHRSUDBNU6FY6UDFFYBN7TGBZXBDZB4OYYXFYXIFJ6RJF6B
# NEXT_PUBLIC_POOL_CONTRACT_ID=CAKEWH7SJCXGV2MH2WZYIX3QDPTSSBQFXYVYBOWAGLNBBZMPLE2US6CS
# NEXT_PUBLIC_ESCROW_CONTRACT_ID=CAJWGUKDTTC3SKN4RAAY72J4DVIIYSCFHX6GIMNTT22ABMISJK4GBCEH
# NEXT_PUBLIC_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
# NEXT_PUBLIC_USDC_ASSET_CODE=USDC
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# NEXT_PUBLIC_APP_URL=http://localhost:3000